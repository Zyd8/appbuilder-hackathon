{
  "expo": {
    "name": "Angat",
    "slug": "buddy-level-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buddylevelup",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.appbuilder.buddylevelup"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.appbuilder.buddylevelup"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BuddyWidget",
              "label": "Buddy",
              "description": "A quick look at your level and daily quests.",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BuddyQuestWidget",
              "label": "Daily Quest",
              "description": "Your next daily quest at a glance.",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BuddyNotesWidget",
              "label": "Today's Notes",
              "description": "A quick look at today's notes.",
              "minWidth": "250dp",
              "minHeight": "160dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withAndroidWorkManagerResolution",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.appbuilder.buddylevelup",
          "widgets": [
            {
              "name": "BuddyWidget",
              "displayName": "Buddy",
              "description": "A quick look at your level and daily quests.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            },
            {
              "name": "BuddyQuestWidget",
              "displayName": "Daily Quest",
              "description": "Your next daily quest at a glance.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            },
            {
              "name": "BuddyNotesWidget",
              "displayName": "Today's Notes",
              "description": "A quick look at today's notes.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
