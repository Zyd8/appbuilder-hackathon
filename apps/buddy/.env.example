# Supabase: required for Google login before onboarding (ADR-005); also used by opt-in backup (Phase 7).
# Without these, the login button is disabled. Copy to .env.local (git-ignored).
# Use the PUBLISHABLE key only, never a secret or service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
